{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TicketsTableCrudOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:Scan",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "__TABLE_ARN__"
    },
    {
      "Sid": "OwnLogGroupOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "__LOG_GROUP_ARN__",
        "__LOG_GROUP_ARN__:*"
      ]
    }
  ]
}
